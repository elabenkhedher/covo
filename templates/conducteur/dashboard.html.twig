{% extends 'app_base.html.twig' %}
{% import '_macros.html.twig' as m %}

{% block title %}Tableau de bord — Conducteur{% endblock %}
{% block page_title %}Bonjour, {{ app.user.prenom }} 🚗{% endblock %}
{% block page_subtitle %}Gérez vos trajets et revenus{% endblock %}

{% block sidebar_nav %}
  <div class="nav-section">Navigation</div>
  <a href="{{ path('conducteur_dashboard') }}"
     class="{{ app.request.attributes.get('_route') == 'conducteur_dashboard' ? 'active' : '' }}">
    <span class="icon">🏠</span> Tableau de bord
  </a>
  <a href="{{ path('trajet_publier') }}"
     class="{{ app.request.attributes.get('_route') == 'trajet_publier' ? 'active' : '' }}">
    <span class="icon">➕</span> Publier un trajet
  </a>
  <a href="{{ path('trajet_mes_trajets') }}"
     class="{{ app.request.attributes.get('_route') == 'trajet_mes_trajets' ? 'active' : '' }}">
    <span class="icon">🚗</span> Mes trajets
  </a>
  <a href="{{ path('conducteur_tracking') }}"
     class="{{ app.request.attributes.get('_route') == 'conducteur_tracking' ? 'active' : '' }}">
    <span class="icon">📍</span> GPS en direct
  </a>
{% endblock %}

{% block body %}

  {# ===== STATS ===== #}
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon blue">🚗</div>
      <div>
        <div class="stat-value">{{ stats.trajets_publies }}</div>
        <div class="stat-label">Trajets publiés</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon green">💰</div>
      <div>
        <div class="stat-value">{{ stats.revenus_total }} DT</div>
        <div class="stat-label">Revenus totaux</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon orange">👥</div>
      <div>
        <div class="stat-value">{{ stats.passagers_transportes }}</div>
        <div class="stat-label">Passagers transportés</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon blue">⭐</div>
      <div>
        <div class="stat-value">{{ stats.note_moyenne }}</div>
        <div class="stat-label">Note moyenne</div>
      </div>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:2fr 1fr;gap:1.5rem;">

    {# ===== TRAJETS À VENIR ===== #}
    <div>
      <div class="page-header" style="margin-bottom:1rem;">
        <h2 style="font-size:1.2rem;">Trajets à venir</h2>
        <a href="{{ path('trajet_publier') }}" class="btn btn-accent btn-sm">+ Nouveau trajet</a>
      </div>

      {% for trajet in trajets_a_venir %}
        <div class="trajet-card">
          <div class="trajet-route">
            <div class="cities">{{ trajet.villeDepart }} <span class="arrow">→</span> {{ trajet.villeArrivee }}</div>
            <div class="trajet-meta">
              <span>📅 {{ trajet.dateDepart|date('D. d M, H:i') }}</span>
              <span>🪑 {{ trajet.placesReservees }}/{{ trajet.placesTotales }} places réservées</span>
            </div>
          </div>
          <div style="text-align:center;">
            <div style="font-family:'Syne',sans-serif;font-weight:800;font-size:1.3rem;color:var(--accent);">
              {{ trajet.prix }} DT
            </div>
            <div style="font-size:0.78rem;color:var(--text-muted);">par place</div>
          </div>
          
          {{ m.badge_statut_trajet(trajet.statut) }}

          <div class="table-actions">
            <a href="{{ path('trajet_modifier', {id: trajet.id}) }}" class="btn btn-outline btn-sm">Modifier</a>
            <button class="btn btn-danger btn-sm" onclick="openModal('cancelModal-{{ trajet.id }}')">Annuler</button>
          </div>
        </div>

        {# Modal annulation #}
        {{ m.confirm_modal('cancelModal-' ~ trajet.id, '⚠️ Annuler le trajet', 'Êtes-vous sûr de vouloir annuler ce trajet ? Les passagers déjà réservés seront remboursés automatiquement.', 'Oui, annuler') }}
        <script>
          document.getElementById('cancelModal-{{ trajet.id }}-confirm').onclick = function() {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = "{{ path('conducteur_annuler_trajet', {id: trajet.id}) }}";
            const token = document.createElement('input');
            token.type = 'hidden';
            token.name = '_token';
            token.value = "{{ csrf_token('annuler_trajet_' ~ trajet.id) }}";
            form.appendChild(token);
            document.body.appendChild(form);
            form.submit();
          };
        </script>
      {% else %}
        <div class="card">
          <div class="card-body">
            {{ m.empty_state('🚗', 'Aucun trajet à venir', 'Vous n\'avez pas encore publié de trajet pour les jours à venir.', 'Publier un trajet', path('trajet_publier')) }}
          </div>
        </div>
      {% endfor %}

      {% if trajets_a_venir|length > 0 %}
        <div style="text-align:center;margin-top:0.75rem;">
          <a href="{{ path('trajet_mes_trajets') }}" style="color:var(--primary);font-size:0.9rem;font-weight:500;">
            Voir tous mes trajets →
          </a>
        </div>
      {% endif %}
    </div>

    {# ===== REVENUS + AVIS ===== #}
    <div>
      <div class="page-header" style="margin-bottom:1rem;">
        <h2 style="font-size:1.2rem;">Revenus ce mois</h2>
      </div>
      <div class="card">
        <div class="card-body">
          <div style="font-family:'Syne',sans-serif;font-size:2rem;font-weight:800;color:var(--accent);">
            {{ revenus_mois.total }} DT
          </div>
          <div style="color:var(--text-muted);font-size:0.85rem;margin-bottom:1rem;">
            {{ "now"|date("F Y") }}
          </div>
          <div style="background:var(--bg);border-radius:8px;padding:0.75rem;">
            <div style="display:flex;justify-content:space-between;font-size:0.85rem;margin-bottom:0.4rem;">
              <span>Trajets ce mois</span><strong>{{ revenus_mois.trajets }}</strong>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:0.85rem;margin-bottom:0.4rem;">
              <span>Passagers</span><strong>{{ revenus_mois.passagers }}</strong>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:0.85rem;">
              <span>Taux de remplissage</span>
              <strong style="color:var(--success);">{{ revenus_mois.taux_remplissage }}%</strong>
            </div>
          </div>
        </div>
      </div>

      <div class="card" style="margin-top:1rem;">
        <div class="card-body">
          <div style="font-size:0.88rem;font-weight:600;margin-bottom:0.75rem;">⭐ Derniers avis</div>
          {% for avis in derniers_avis %}
            <div style="font-size:0.82rem;color:var(--text-muted);padding:0.5rem 0;
                        {% if not loop.last %}border-bottom:1px solid var(--border);{% endif %}">
              {{ m.stars(avis.note) }}
              <div style="margin-top:0.25rem;">
                "{{ avis.commentaire }}" — {{ avis.auteur.prenom }} {{ avis.auteur.nom[0] }}.
              </div>
            </div>
          {% else %}
            <p style="font-size:0.85rem;color:var(--text-muted);">Aucun avis pour l'instant.</p>
          {% endfor %}
        </div>
      </div>
    </div>

  </div>
{% endblock %}
