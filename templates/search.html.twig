{% extends 'app_base.html.twig' %}
{% import '_macros.html.twig' as m %}

{% block title %}Rechercher un trajet{% endblock %}

{% block extra_css %}
<style>
  .search-hero {
    background: linear-gradient(135deg, var(--primary) 0%, #0f2147 100%);
    padding: 2.5rem 2rem;
  }
  .search-hero h1 { color: #fff; font-size: 1.8rem; margin-bottom: 0.5rem; }
  .search-hero p { color: rgba(255,255,255,0.6); }
  .search-bar-wrapper {
    background: #fff; border-radius: var(--radius);
    padding: 1.5rem; margin-top: 1.5rem; box-shadow: var(--shadow);
  }
  .search-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr) auto;
    gap: 1rem; align-items: end;
  }
  .filter-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
  .filter-tag {
    background: #eff6ff; color: var(--primary);
    border: 1px solid #bfdbfe; border-radius: 50px;
    padding: 0.3rem 0.9rem; font-size: 0.82rem; font-weight: 500; cursor: pointer;
  }
  .filter-tag:hover { background: var(--primary); color: #fff; }
  .results-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.5rem 2rem 0.75rem;
  }
  .results-header h3 { font-size: 1.1rem; }
  .results-header .count { color: var(--text-muted); font-size: 0.9rem; }
  .sort-select {
    padding: 0.5rem 1rem; border: 1px solid var(--border);
    border-radius: 8px; font-size: 0.88rem; background: #fff; cursor: pointer;
  }
  .results-list { padding: 0 2rem 2rem; }
  @media(max-width:700px) { .search-grid { grid-template-columns: 1fr; } }
</style>
{% endblock %}

{% block sidebar_nav %}
  {% if app.user %}
    {% if 'ROLE_CONDUCTEUR' in app.user.roles %}
      <a href="{{ path('conducteur_dashboard') }}"><span class="icon">🏠</span> Tableau de bord</a>
      <a href="{{ path('trajet_publier') }}"><span class="icon">➕</span> Publier un trajet</a>
      <a href="{{ path('trajet_mes_trajets') }}"><span class="icon">🚗</span> Mes trajets</a>
    {% else %}
      <a href="{{ path('passager_dashboard') }}"><span class="icon">🏠</span> Tableau de bord</a>
      <a href="{{ path('trajet_search') }}" class="active"><span class="icon">🔍</span> Rechercher un trajet</a>
      <a href="{{ path('passager_reservations') }}"><span class="icon">📋</span> Mes réservations</a>
    {% endif %}
  {% else %}
    <a href="{{ path('app_home') }}"><span class="icon">🏠</span> Accueil</a>
    <a href="{{ path('trajet_search') }}" class="active"><span class="icon">🔍</span> Rechercher un trajet</a>
  {% endif %}
{% endblock %}

{% block page_title %}{% endblock %}
{% block page_subtitle %}{% endblock %}

{% block body %}

  {# ===== SEARCH HERO ===== #}
  <div class="search-hero" style="margin:-1.5rem -1.5rem 0;">
    <h1>🔍 Trouvez votre trajet</h1>
    <p>Recherchez parmi les trajets disponibles</p>
    <div class="search-bar-wrapper">
      <form action="{{ path('trajet_search') }}" method="GET" id="searchForm">
        <div class="search-grid">
          <div class="form-group" style="margin:0">
            <label>Départ</label>
            <input type="text" class="form-control" name="villeDepart"
                   placeholder="Tunis" value="{{ filtres.villeDepart|default('') }}">
          </div>
          <div class="form-group" style="margin:0">
            <label>Arrivée</label>
            <input type="text" class="form-control" name="villeArrivee"
                   placeholder="Kélibia" value="{{ filtres.villeArrivee|default('') }}">
          </div>
          <div class="form-group" style="margin:0">
            <label>Date</label>
            <input type="date" class="form-control" name="date"
                   value="{{ filtres.date|default('') }}">
          </div>
          <div class="form-group" style="margin:0">
            <label>Places min.</label>
            <select class="form-control" name="nbPlaces">
              {% for i in 1..3 %}
                <option value="{{ i }}" {{ filtres.nbPlaces|default(1) == i ? 'selected' : '' }}>
                  {{ i }} place{{ i > 1 ? 's' : '' }}
                </option>
              {% endfor %}
            </select>
          </div>
          <button type="submit" class="btn btn-accent">Rechercher</button>
        </div>
      </form>
      <div class="filter-tags">
        <div class="filter-tag" onclick="applyQuickFilter('matin')">🕐 Ce matin</div>
        <div class="filter-tag" onclick="applyQuickFilter('aprem')">🌅 Cet après-midi</div>
        <div class="filter-tag" onclick="applyQuickFilter('budget')">💰 Moins de 10 DT</div>
        <div class="filter-tag" onclick="applyQuickFilter('note')">⭐ Note +4.5</div>
        <div class="filter-tag" onclick="applyQuickFilter('nofumeur')">🚭 Non-fumeur</div>
      </div>
    </div>
  </div>

  {# ===== RESULTS ===== #}
  <div class="results-header">
    <div>
      <h3>Résultats de recherche</h3>
      <span class="count">{{ trajets|length }} trajet(s) disponible(s)</span>
    </div>
    <form action="{{ path('trajet_search') }}" method="GET" id="sortForm">
      <input type="hidden" name="depart" value="{{ filters.depart|default('') }}">
      <input type="hidden" name="arrivee" value="{{ filters.arrivee|default('') }}">
      <input type="hidden" name="date" value="{{ filters.date|default('') }}">
      <select class="sort-select" name="sort" onchange="document.getElementById('sortForm').submit()">
        <option value="depart"  {{ filters.sort|default('depart')  == 'depart'  ? 'selected' : '' }}>Trier par : Départ</option>
        <option value="prix_asc"   {{ filters.sort|default('') == 'prix_asc'   ? 'selected' : '' }}>Prix croissant</option>
        <option value="prix_desc"  {{ filters.sort|default('') == 'prix_desc'  ? 'selected' : '' }}>Prix décroissant</option>
        <option value="note"       {{ filters.sort|default('') == 'note'       ? 'selected' : '' }}>Mieux notés</option>
      </select>
    </form>
  </div>

  <div class="results-list">
    {% for trajet in trajets %}
      <div class="trajet-card"
           onclick="window.location='{{ path('trajet_detail', {id: trajet.id}) }}'"
           style="cursor:pointer;">
        <div class="trajet-route">
          <div class="cities">{{ trajet.villeDepart }} <span class="arrow">→</span> {{ trajet.villeArrivee }}</div>
          <div class="trajet-meta">
            <span>📅 {{ trajet.dateDepart|date('D. d M · H:i') }}</span>
            <span>🪑 {{ trajet.placesDisponibles }} places dispo</span>
            {% if trajet.dureeEstimee %}
              <span>⏱ ~{{ trajet.dureeEstimee }}</span>
            {% endif %}
          </div>
        </div>
        <div class="trajet-driver">
          {% set conducteur = conducteurs[trajet.conducteurId]|default(null) %}
          {% if conducteur %}
            {{ m.avatar(conducteur.initials, 'md', 'primary') }}
            <div>
              <div class="driver-name">{{ conducteur.prenom }} {{ conducteur.nom|slice(0, 1) }}.</div>
              <div class="driver-rating">
                {{ m.stars(conducteur.noteMoyenne|default(5)) }}
              </div>
            </div>
          {% else %}
            {{ m.avatar('?', 'md', 'gray') }}
            <div><div class="driver-name">Conducteur inconnu</div></div>
          {% endif %}
        </div>
        <div class="trajet-price">{{ trajet.prix }} DT</div>
        {% if trajet.placesDisponibles > 0 %}
          <a href="{{ path('trajet_detail', {id: trajet.id}) }}"
             class="btn btn-accent btn-sm"
             onclick="event.stopPropagation()">Réserver</a>
        {% else %}
          <button class="btn btn-sm" style="background:#e2e8f0;color:var(--text-muted);cursor:not-allowed"
                  disabled>Complet</button>
        {% endif %}
      </div>
    {% else %}
      {{ m.empty_state('😔', 'Aucun trajet trouvé', 'Aucun trajet ne correspond à vos critères pour le moment.', 'Effacer les filtres', path('trajet_search')) }}
    {% endfor %}
  </div>

{% endblock %}

{% block extra_js %}
<script>
  function applyQuickFilter(type) {
    const form = document.getElementById('searchForm');
    const params = { matin: {heure:'matin'}, aprem: {heure:'aprem'}, budget: {prix_max:10}, note: {note_min:4.5}, nofumeur: {nofumeur:1} };
    const p = params[type] || {};
    Object.entries(p).forEach(([k,v]) => {
      let inp = form.querySelector('[name="'+k+'"]');
      if (!inp) { inp = document.createElement('input'); inp.type='hidden'; inp.name=k; form.appendChild(inp); }
      inp.value = v;
    });
    form.submit();
  }
</script>
{% endblock %}
