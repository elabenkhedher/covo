{% extends 'auth_base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block extra_auth_style %}
  .divider { text-align: center; color: var(--text-muted); font-size: 0.85rem; margin: 1.25rem 0; position: relative; }
  .divider::before, .divider::after { content: ''; position: absolute; top: 50%; width: 42%; height: 1px; background: var(--border); }
  .divider::before { left: 0; }
  .divider::after { right: 0; }
  .signup-link { text-align: center; margin-top: 1.25rem; font-size: 0.9rem; color: var(--text-muted); }
  .signup-link a { color: var(--primary); font-weight: 600; }
{% endblock %}

{% block auth_illustration %}🔒{% endblock %}
{% block auth_left_title %}Mot de passe oublié ?{% endblock %}
{% block auth_left_text %}Pas d'inquiétude, nous allons vous aider à récupérer l'accès à votre compte.{% endblock %}

{% block auth_form %}
  <h2>Récupération</h2>
  <p class="subtitle">Entrez votre adresse email pour recevoir un lien de réinitialisation</p>

  <div class="form-card">
    {% if app.request.query.get('sent') %}
      <div class="alert alert-success" style="margin-bottom:1rem;">
        ✅ Lien envoyé ! Vérifiez votre boîte mail.
      </div>
    {% endif %}

    <form action="{{ path('app_forgot_password_request') }}" method="POST">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot-password') }}">

      <div class="form-group">
        <label for="email">Adresse email</label>
        <input type="email" class="form-control" id="email" name="email"
               placeholder="exemple@iset.tn" required>
        <div class="form-error"></div>
      </div>

      <button type="submit" class="btn btn-primary btn-full">
        Envoyer le lien →
      </button>

      <div class="divider">ou</div>

      <div class="signup-link">
        <a href="{{ path('app_login') }}">Retour à la connexion</a>
      </div>
    </form>
  </div>

  <div style="text-align:center;margin-top:1.5rem;">
    <a href="{{ path('app_home') }}" style="color:var(--text-muted);font-size:0.88rem;">← Retour à l'accueil</a>
  </div>
{% endblock %}
