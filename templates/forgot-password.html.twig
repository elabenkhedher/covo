{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — CovoISET{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="{{ asset('assets/style.css') }}">
  <style>
    body { display: flex; min-height: 100vh; }
    .auth-left {
      flex: 1;
      background: linear-gradient(160deg, var(--primary) 0%, #0f2147 100%);
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding: 3rem;
      position: relative;
      overflow: hidden;
    }
    .auth-left::before {
      content: '';
      position: absolute;
      width: 400px; height: 400px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(249,115,22,0.2), transparent 70%);
      top: -100px; right: -100px;
    }
    .auth-left-content { position: relative; z-index: 1; text-align: center; max-width: 380px; }
    .auth-left .logo { font-family: 'Syne', sans-serif; font-size: 2rem; font-weight: 800; color: #fff; margin-bottom: 1.5rem; }
    .auth-left .logo span { color: var(--accent); }
    .auth-left h2 { color: #fff; font-size: 1.6rem; margin-bottom: 1rem; }
    .auth-left p { color: rgba(255,255,255,0.6); line-height: 1.7; font-size: 0.95rem; }
    .auth-left .illustration { font-size: 6rem; margin-bottom: 1.5rem; }
    .auth-right {
      width: 480px;
      display: flex; align-items: center; justify-content: center;
      padding: 2rem;
      background: var(--bg);
    }
    .auth-form-box { width: 100%; max-width: 400px; }
    .auth-form-box h2 { font-size: 1.8rem; font-weight: 800; margin-bottom: 0.5rem; }
    .auth-form-box .subtitle { color: var(--text-muted); margin-bottom: 2rem; font-size: 0.95rem; }
    .form-card { background: #fff; border-radius: var(--radius); padding: 2rem; box-shadow: var(--shadow); }
    .divider { text-align: center; color: var(--text-muted); font-size: 0.85rem; margin: 1.25rem 0; position: relative; }
    .divider::before, .divider::after {
      content: ''; position: absolute; top: 50%; width: 42%; height: 1px; background: var(--border);
    }
    .divider::before { left: 0; }
    .divider::after { right: 0; }
    .signup-link { text-align: center; margin-top: 1.25rem; font-size: 0.9rem; color: var(--text-muted); }
    .signup-link a { color: var(--primary); font-weight: 600; }
    @media(max-width:768px) { .auth-left { display: none; } .auth-right { width: 100%; } }
  </style>
{% endblock %}

{% block body %}
  <div class="auth-left">
    <div class="auth-left-content">
      <div class="logo">Covo<span>ISET</span></div>
      <div class="illustration">🔒</div>
      <h2>Mot de passe oublié ?</h2>
      <p>Pas d'inquiétude, nous allons vous aider à récupérer l'accès à votre compte.</p>
    </div>
  </div>

  <div class="auth-right">
    <div class="auth-form-box">
      <h2>Récupération</h2>
      <p class="subtitle">Entrez votre adresse email pour recevoir un lien de réinitialisation</p>

      <div class="form-card">
        <div class="form-group">
          <label>Adresse email</label>
          <input type="email" class="form-control" id="email" placeholder="exemple@iset.tn" required>
          <div class="form-error"></div>
        </div>

        <button class="btn btn-primary btn-full" onclick="handleForgot()">
          Envoyer le lien →
        </button>

        <div class="divider">ou</div>

        <div class="signup-link">
          <a href="{{ path('app_login') }}">Retour à la connexion</a>
        </div>
      </div>

      <div style="text-align:center;margin-top:1.5rem;">
        <a href="{{ path('app_home') }}" style="color:var(--text-muted);font-size:0.88rem;">← Retour à l'accueil</a>
      </div>
    </div>
  </div>

  <!-- Toast container -->
  <div class="toast-container"></div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('assets/app.js') }}"></script>
  <script>
    function handleForgot() {
      const email = document.getElementById('email');
      let valid = true;
      if (!email.value.trim()) { email.classList.add('error'); valid = false; }
      if (!valid) { showToast('Veuillez entrer votre adresse email.', 'error'); return; }

      showToast('Lien de réinitialisation envoyé ! Vérifiez votre boîte mail.', 'success');
      setTimeout(() => {
        window.location.href = '{{ path('app_login') }}';
      }, 2500);
    }
  </script>
{% endblock %}
