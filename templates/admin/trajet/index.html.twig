{% extends 'app_base.html.twig' %}

{% block title %}Modération des trajets{% endblock %}
{% block page_title %}Modération des trajets{% endblock %}
{% block page_subtitle %}Gestion et surveillance des annonces publiées{% endblock %}


{% block body %}
<div class="card" style="margin-bottom: 2rem;">
  <div class="card-body">
    <form method="GET" action="{{ path('admin_trajet_index') }}" style="display: flex; gap: 1.25rem; flex-wrap: wrap; align-items: flex-end;">
        <div class="form-group" style="margin-bottom: 0; flex: 1; min-width: 150px;">
            <label>Statut</label>
            <select name="statut" class="form-control" style="padding: 0.6rem 1rem;">
                <option value="">Tous les statuts</option>
                <option value="actif" {{ filtres.statut == 'actif' ? 'selected' : '' }}>✅ Actif</option>
                <option value="en_cours" {{ filtres.statut == 'en_cours' ? 'selected' : '' }}>⏳ En cours</option>
                <option value="annule" {{ filtres.statut == 'annule' ? 'selected' : '' }}>🚫 Annulé</option>
                <option value="termine" {{ filtres.statut == 'termine' ? 'selected' : '' }}>🏁 Terminé</option>
            </select>
        </div>
        <div class="form-group" style="margin-bottom: 0; flex: 1; min-width: 150px;">
            <label>Visibilité</label>
            <select name="masque" class="form-control" style="padding: 0.6rem 1rem;">
                <option value="">Tous</option>
                <option value="1" {{ filtres.masque == '1' ? 'selected' : '' }}>Masqués uniquement</option>
                <option value="0" {{ filtres.masque == '0' ? 'selected' : '' }}>Visibles uniquement</option>
            </select>
        </div>
        <div class="form-group" style="margin-bottom: 0; flex: 1; min-width: 150px;">
            <label>Ville Départ</label>
            <input type="text" name="villeDepart" class="form-control" placeholder="Ex: Tunis" value="{{ filtres.villeDepart }}" style="padding: 0.6rem 1rem;">
        </div>
        <div class="form-group" style="margin-bottom: 0; flex: 1; min-width: 150px;">
            <label>Ville Arrivée</label>
            <input type="text" name="villeArrivee" class="form-control" placeholder="Ex: Sousse" value="{{ filtres.villeArrivee }}" style="padding: 0.6rem 1rem;">
        </div>
        <div style="display: flex; gap: 0.5rem; margin-bottom: 0.1rem;">
            <button type="submit" class="btn btn-primary" style="padding: 0.6rem 1.5rem;">Filtrer</button>
            <a href="{{ path('admin_trajet_index') }}" class="btn btn-outline" title="Réinitialiser" style="padding: 0.6rem 1.2rem;">🔄</a>
        </div>
    </form>
  </div>
</div>

<div class="table-wrapper">
    <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; background: var(--bg-card);">
        <strong style="font-family: 'Syne', sans-serif; font-size: 1.1rem; color: var(--text);">🚘 Liste des trajets</strong>
        <span class="badge badge-gray" style="font-size: 0.85rem;">{{ trajetsData|length }} résultat(s)</span>
    </div>

    <div style="overflow-x: auto;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Conducteur</th>
                    <th>Départ → Arrivée</th>
                    <th>Date & Heure</th>
                    <th style="text-align: center;">Places</th>
                    <th style="text-align: right;">Prix</th>
                    <th style="text-align: center;">Statut</th>
                    <th style="text-align: center;">Signal.</th>
                    <th style="text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for item in trajetsData %}
                    {% set t = item.trajet %}
                    {% set c = item.conducteur %}
                    <tr style="{{ t.isMasque ? 'background-color: #fffbeb;' : '' }}">
                        <td>
                            <code style="font-size: 0.8rem; background: var(--bg); padding: 4px 6px; border-radius: 6px; color: var(--text-muted); font-weight: 600;">{{ t.id|slice(0, 8) }}</code>
                        </td>
                        <td>
                            {% if c %}
                                <div style="font-weight: 700; color: var(--text); line-height: 1.2; font-family: 'Syne', sans-serif;">{{ c.prenom }} {{ c.nom }}</div>
                                <div style="font-size: 0.8rem; color: var(--text-muted);">{{ c.email }}</div>
                            {% else %}
                                <span style="color: var(--danger); font-weight: 600; font-size: 0.85rem;">Inconnu ({{ t.conducteurId }})</span>
                            {% endif %}
                        </td>
                        <td>
                            <div style="display: flex; align-items: center; gap: 0.4rem; font-family: 'DM Sans', sans-serif; font-weight: 600;">
                                <span>{{ t.villeDepart }}</span>
                                <span style="color: var(--accent);">➔</span>
                                <span>{{ t.villeArrivee }}</span>
                            </div>
                        </td>
                        <td>
                            <div style="font-weight: 600; color: var(--text);">{{ t.dateDepart|date('d/m/Y') }}</div>
                            <div style="font-size: 0.8rem; color: var(--text-muted);">à {{ t.heureDepart }}</div>
                        </td>
                        <td style="text-align: center; font-weight: 600;">
                            {{ t.nbPlacesDisponibles }} <span style="color: var(--text-muted); font-weight: 400;">/ {{ t.nbPlacesTotal }}</span>
                        </td>
                        <td style="text-align: right; font-family: 'Syne', sans-serif; font-weight: 700; color: var(--primary);">
                            {{ t.prix|number_format(0, '', ' ') }} TND
                        </td>
                        <td style="text-align: center;">
                            {% if t.statut == 'actif' %}
                                <span class="badge badge-success">Actif</span>
                            {% elseif t.statut == 'en_cours' %}
                                <span class="badge badge-info">En cours</span>
                            {% elseif t.statut == 'annule' %}
                                <span class="badge badge-danger">Annulé</span>
                            {% else %}
                                <span class="badge badge-gray">Terminé</span>
                            {% endif %}
                            
                            {% if t.isMasque %}
                                <div style="margin-top: 0.35rem;"><span class="badge badge-warning" style="font-size: 0.65rem;">🚫 Masqué</span></div>
                            {% endif %}
                        </td>
                        <td style="text-align: center;">
                            {% if t.signalementsCount > 0 %}
                                <span class="badge badge-danger">⚠️ {{ t.signalementsCount }}</span>
                            {% else %}
                                <span style="color: var(--text-muted); font-size: 0.85rem;">—</span>
                            {% endif %}
                        </td>
                        <td style="text-align: center;">
                            <a href="{{ path('admin_trajet_detail', {id: t.id}) }}" class="btn btn-sm btn-outline" style="padding: 0.35rem 0.8rem;">Détails</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" style="padding: 4rem; text-align: center; color: var(--text-muted);">
                            <div style="font-size: 2rem; margin-bottom: 0.5rem;">🔍</div>
                            <div style="font-weight: 600; color: var(--text);">Aucun trajet ne correspond à ces critères.</div>
                            <div style="font-size: 0.85rem;">Essayez de modifier les filtres.</div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
