{% extends 'app_base.html.twig' %}

{% block title %}Modération des trajets{% endblock %}
{% block page_title %}Modération des trajets{% endblock %}
{% block page_subtitle %}Gestion et surveillance des annonces publiées{% endblock %}

{% block sidebar_nav %}
    <div class="nav-section">Administration</div>
    <a href="{{ path('admin_trajet_index') }}" class="active">
        <span class="icon">🛡️</span> Trajets
    </a>
{% endblock %}

{% block body %}
<div class="card" style="margin-bottom: 2rem;">
    <form method="GET" action="{{ path('admin_trajet_index') }}" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; align-items: end;">
        <div>
            <label class="form-label">Statut</label>
            <select name="statut" class="form-control">
                <option value="">Tous les statuts</option>
                <option value="actif" {{ filtres.statut == 'actif' ? 'selected' : '' }}>Actif</option>
                <option value="en_cours" {{ filtres.statut == 'en_cours' ? 'selected' : '' }}>En cours</option>
                <option value="annule" {{ filtres.statut == 'annule' ? 'selected' : '' }}>Annulé</option>
                <option value="termine" {{ filtres.statut == 'termine' ? 'selected' : '' }}>Terminé</option>
            </select>
        </div>
        <div>
            <label class="form-label">Visibilité</label>
            <select name="masque" class="form-control">
                <option value="">Tous</option>
                <option value="1" {{ filtres.masque == '1' ? 'selected' : '' }}>Masqués uniquement</option>
                <option value="0" {{ filtres.masque == '0' ? 'selected' : '' }}>Visibles uniquement</option>
            </select>
        </div>
        <div>
            <label class="form-label">Ville Départ</label>
            <input type="text" name="villeDepart" class="form-control" placeholder="Ex: Tunis" value="{{ filtres.villeDepart }}">
        </div>
        <div>
            <label class="form-label">Ville Arrivée</label>
            <input type="text" name="villeArrivee" class="form-control" placeholder="Ex: Sousse" value="{{ filtres.villeArrivee }}">
        </div>
        <div style="display: flex; gap: 0.5rem;">
            <button type="submit" class="btn btn-primary" style="flex: 1;">Filtrer</button>
            <a href="{{ path('admin_trajet_index') }}" class="btn btn-outline" title="Réinitialiser">🔄</a>
        </div>
    </form>
</div>

<div class="card" style="padding: 0; overflow: hidden;">
    <div style="overflow-x: auto;">
        <table class="table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: var(--bg-body); border-bottom: 2px solid var(--border-color);">
                    <th style="padding: 1rem; text-align: left;">ID</th>
                    <th style="padding: 1rem; text-align: left;">Conducteur</th>
                    <th style="padding: 1rem; text-align: left;">Départ → Arrivée</th>
                    <th style="padding: 1rem; text-align: left;">Date & Heure</th>
                    <th style="padding: 1rem; text-align: center;">Places</th>
                    <th style="padding: 1rem; text-align: right;">Prix</th>
                    <th style="padding: 1rem; text-align: center;">Statut</th>
                    <th style="padding: 1rem; text-align: center;">Signal.</th>
                    <th style="padding: 1rem; text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for item in trajetsData %}
                    {% set t = item.trajet %}
                    {% set c = item.conducteur %}
                    <tr style="border-bottom: 1px solid var(--border-color); {{ t.isMasque ? 'background-color: rgba(255, 165, 0, 0.05);' : '' }}">
                        <td style="padding: 1rem;">
                            <code style="font-size: 0.8rem; background: var(--bg-body); padding: 2px 4px; border-radius: 4px;">{{ t.id|slice(0, 8) }}</code>
                        </td>
                        <td style="padding: 1rem;">
                            {% if c %}
                                <strong>{{ c.prenom }} {{ c.nom }}</strong><br>
                                <span style="font-size: 0.8rem; color: var(--text-muted);">{{ c.email }}</span>
                            {% else %}
                                <span style="color: var(--danger);">Inconnu ({{ t.conducteurId }})</span>
                            {% endif %}
                        </td>
                        <td style="padding: 1rem;">
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <strong>{{ t.villeDepart }}</strong>
                                <span>➡️</span>
                                <strong>{{ t.villeArrivee }}</strong>
                            </div>
                        </td>
                        <td style="padding: 1rem;">
                            {{ t.dateDepart|date('d/m/Y') }}<br>
                            <span style="font-size: 0.8rem; color: var(--text-muted);">à {{ t.heureDepart }}</span>
                        </td>
                        <td style="padding: 1rem; text-align: center;">
                            {{ t.nbPlacesDisponibles }} / {{ t.nbPlacesTotal }}
                        </td>
                        <td style="padding: 1rem; text-align: right; font-weight: bold;">
                            {{ t.prix|number_format(2, ',', ' ') }} DT
                        </td>
                        <td style="padding: 1rem; text-align: center;">
                            {% if t.statut == 'actif' %}
                                <span class="badge badge-success">Actif</span>
                            {% elseif t.statut == 'en_cours' %}
                                <span class="badge badge-info">En cours</span>
                            {% elseif t.statut == 'annule' %}
                                <span class="badge badge-danger">Annulé</span>
                            {% else %}
                                <span class="badge" style="background: #6c757d; color: white;">Terminé</span>
                            {% endif %}
                            
                            {% if t.isMasque %}
                                <br><span style="font-size: 0.7rem; color: var(--danger); font-weight: bold; text-transform: uppercase;">🚫 Masqué</span>
                            {% endif %}
                        </td>
                        <td style="padding: 1rem; text-align: center;">
                            <span style="color: {{ t.signalementsCount > 0 ? 'var(--danger)' : 'var(--text-muted)' }}; font-weight: bold;">
                                {{ t.signalementsCount }}
                            </span>
                        </td>
                        <td style="padding: 1rem; text-align: center;">
                            <a href="{{ path('admin_trajet_detail', {id: t.id}) }}" class="btn btn-sm btn-outline">Voir</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" style="padding: 3rem; text-align: center; color: var(--text-muted);">
                            Aucun trajet ne correspond à ces critères.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div style="margin-top: 1rem; color: var(--text-muted); font-size: 0.9rem;">
    Total : <strong>{{ trajetsData|length }}</strong> trajet(s) affiché(s)
</div>
{% endblock %}
