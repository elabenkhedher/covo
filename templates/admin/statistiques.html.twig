{% extends 'app_base.html.twig' %}

{% block title %}Administration — Statistiques{% endblock %}
{% block page_title %}Tableau de bord analytique{% endblock %}
{% block page_subtitle %}Vue d'ensemble et performances de la plateforme CovoISET{% endblock %}

{% block extra_css %}
<style>
  .stats-header {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 2rem;
    animation: fadeInDown 0.5s ease-out;
  }

  .btn-telecharger {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--primary);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.95rem;
    font-family: 'DM Sans', sans-serif;
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: all 0.2s;
  }
  
  .btn-telecharger:hover {
    background: var(--primary-light);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    color: white;
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .kpi-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
    display: flex;
    align-items: center;
    gap: 1.25rem;
    transition: all 0.3s ease;
    animation: fadeInUp 0.5s ease-out backwards;
  }

  .kpi-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--primary-light);
  }

  .kpi-icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .kpi-icon.primary { background: #e0e7ff; color: var(--primary); }
  .kpi-icon.accent { background: #ffedd5; color: var(--accent); }
  .kpi-icon.success { background: #d1fae5; color: var(--success); }
  .kpi-icon.warning { background: #fef3c7; color: var(--warning); }

  .kpi-details {
    display: flex;
    flex-direction: column;
  }

  .kpi-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .kpi-value {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1.2;
    white-space: nowrap;
    letter-spacing: -0.5px;
  }

  .kpi-sub {
    font-size: 0.8rem;
    color: var(--success);
    font-weight: 500;
    margin-top: 0.4rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* Charts Section */
  .charts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .chart-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
    animation: fadeInUp 0.7s ease-out backwards;
    transition: all 0.3s ease;
  }
  
  .chart-card:hover {
    box-shadow: var(--shadow-lg);
  }

  .chart-title {
    font-family: 'Syne', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 2px solid var(--bg);
    padding-bottom: 0.75rem;
  }

  .chart-container {
    position: relative;
    height: 250px;
    width: 100%;
  }

  /* Detailed Tables Layout */
  .details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .detail-card {
    background: var(--bg-card);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
    animation: fadeInUp 0.9s ease-out backwards;
    border: 1px solid var(--border);
  }

  .detail-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .detail-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--border);
  }

  .detail-item:last-child {
    border-bottom: none;
  }

  .detail-item strong {
    font-family: 'Syne', sans-serif;
    font-size: 1.1rem;
    color: var(--text);
  }

  .badge {
    padding: 0.35rem 0.8rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .badge-success { background: #d1fae5; color: #065f46; }
  .badge-primary { background: #e0e7ff; color: var(--primary); }
  .badge-accent { background: #ffedd5; color: var(--accent); }
  .badge-warning { background: #fef3c7; color: #92400e; }
  .badge-danger { background: #fee2e2; color: #991b1b; }
  .badge-gray { background: #f1f5f9; color: #475569; }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-15px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
{% endblock %}

{% block body %}

<div class="stats-header">
  <a href="{{ path('admin_statistiques_telecharger') }}" class="btn-telecharger">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
    Exporter en CSV
  </a>
</div>

<div class="kpi-grid">
  <div class="kpi-card" style="animation-delay: 0.1s;">
    <div class="kpi-icon primary">🚗</div>
    <div class="kpi-details">
      <span class="kpi-label">Trajets Publiés</span>
      <span class="kpi-value">{{ totalTrajets }}</span>
    </div>
  </div>

  <div class="kpi-card" style="animation-delay: 0.2s;">
    <div class="kpi-icon accent">📋</div>
    <div class="kpi-details">
      <span class="kpi-label">Réservations</span>
      <span class="kpi-value">{{ totalReservations }}</span>
    </div>
  </div>

  <div class="kpi-card" style="animation-delay: 0.3s;">
    <div class="kpi-icon success">💰</div>
    <div class="kpi-details">
      <span class="kpi-label">Volume Financier</span>
      <span class="kpi-value">{{ totalArgent|number_format(0, '.', ' ') }}<span style="font-size:1.1rem; margin-left:0.2rem; color:var(--text-muted)">TND</span></span>
    </div>
  </div>

  <div class="kpi-card" style="animation-delay: 0.4s;">
    <div class="kpi-icon warning">👥</div>
    <div class="kpi-details">
      <span class="kpi-label">Utilisateurs</span>
      <span class="kpi-value">{{ totalUsers }}</span>
    </div>
  </div>

  <div class="kpi-card" style="animation-delay: 0.5s;">
    <div class="kpi-icon primary">⭐</div>
    <div class="kpi-details">
      <span class="kpi-label">Avis Globaux</span>
      <span class="kpi-value">{{ totalAvis }}</span>
      <span class="kpi-sub">Note moyenne: {{ noteMoyenne }} / 5</span>
    </div>
  </div>
</div>

<div class="charts-grid">
  <div class="chart-card" style="animation-delay: 0.6s;">
    <div class="chart-title">🚘 Répartition des Trajets</div>
    <div class="chart-container">
      <canvas id="trajetsChart"></canvas>
    </div>
  </div>
  
  <div class="chart-card" style="animation-delay: 0.7s;">
    <div class="chart-title">👥 Structure des Utilisateurs</div>
    <div class="chart-container">
      <canvas id="usersChart"></canvas>
    </div>
  </div>

  <div class="chart-card" style="animation-delay: 0.8s;">
    <div class="chart-title">🎟️ Statut des Réservations</div>
    <div class="chart-container">
      <canvas id="reservationsChart"></canvas>
    </div>
  </div>
</div>

<div class="details-grid">
  <div class="detail-card">
    <div class="chart-title">Détails Trajets</div>
    <ul class="detail-list">
      <li class="detail-item">
        <span class="badge badge-success">Actif</span>
        <strong>{{ trajetsActif }}</strong>
      </li>
      <li class="detail-item">
        <span class="badge badge-primary">En cours</span>
        <strong>{{ trajetsEnCours }}</strong>
      </li>
      <li class="detail-item">
        <span class="badge badge-gray">Terminé</span>
        <strong>{{ trajetsTermine }}</strong>
      </li>
      <li class="detail-item">
        <span class="badge badge-danger">Annulé</span>
        <strong>{{ trajetsAnnule }}</strong>
      </li>
    </ul>
  </div>

  

  <div class="detail-card">
    <div class="chart-title">Détails Utilisateurs</div>
    <ul class="detail-list">
      <li class="detail-item">
        <span class="badge badge-success">Actifs</span>
        <strong>{{ usersActif }}</strong>
      </li>
      <li class="detail-item">
        <span class="badge badge-warning">En attente</span>
        <strong>{{ usersEnAttente }}</strong>
      </li>
      <li class="detail-item">
        <span class="badge badge-danger">Suspendus</span>
        <strong>{{ usersSuspendu }}</strong>
      </li>
      <li class="detail-item">
        <span class="badge badge-accent">Conducteurs / Passagers</span>
        <strong>{{ conducteurs }} / {{ passagers }}</strong>
      </li>
    </ul>
  </div>

  <div class="detail-card">
    <div class="chart-title">Détails Réservations</div>
    <ul class="detail-list">
      <li class="detail-item">
        <span class="badge badge-success">Confirmée</span>
        <strong>{{ reservationsConfirmee }}</strong>
      </li>
      <li class="detail-item">
        <span class="badge badge-gray">Terminée</span>
        <strong>{{ reservationsTerminee }}</strong>
      </li>
      <li class="detail-item">
        <span class="badge badge-danger">Annulée</span>
        <strong>{{ reservationsAnnulee }}</strong>
      </li>
    </ul>
  </div>

  
</div>

{% endblock %}

{% block extra_js %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const commonOptions = {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                position: 'bottom',
                labels: {
                    usePointStyle: true,
                    padding: 20,
                    font: { family: "'DM Sans', sans-serif", size: 12, color: '#64748b' }
                }
            }
        },
        cutout: '70%',
        animation: {
            animateScale: true,
            animateRotate: true
        }
    };

    const ctxTrajets = document.getElementById('trajetsChart').getContext('2d');
    new Chart(ctxTrajets, {
        type: 'doughnut',
        data: {
            labels: ['Actif', 'En cours', 'Terminé', 'Annulé'],
            datasets: [{
                data: [{{ trajetsActif }}, {{ trajetsEnCours }}, {{ trajetsTermine }}, {{ trajetsAnnule }}],
                backgroundColor: ['#10b981', '#1B3A6B', '#94a3b8', '#ef4444'],
                borderWidth: 0,
                hoverOffset: 6
            }]
        },
        options: commonOptions
    });
    const ctxReservations = document.getElementById('reservationsChart').getContext('2d');
    new Chart(ctxReservations, {
        type: 'doughnut',
        data: {
            labels: ['Confirmée', 'Terminée', 'Annulée'],
            datasets: [{
                data: [{{ reservationsConfirmee }}, {{ reservationsTerminee }}, {{ reservationsAnnulee }}],
                backgroundColor: ['#10b981', '#94a3b8', '#ef4444'],
                borderWidth: 0,
                hoverOffset: 6
            }]
        },
        options: commonOptions
    });

    const ctxUsers = document.getElementById('usersChart').getContext('2d');
    new Chart(ctxUsers, {
        type: 'doughnut',
        data: {
            labels: ['Conducteurs', 'Passagers', 'Admins'],
            datasets: [{
                data: [{{ conducteurs }}, {{ passagers }}, {{ admins }}],
                backgroundColor: ['#F97316', '#1B3A6B', '#f59e0b'],
                borderWidth: 0,
                hoverOffset: 6
            }]
        },
        options: commonOptions
    });


});
</script>
{% endblock %}
