<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}CovoISET{% endblock %} — CovoISET</title>
  <link rel="stylesheet" href="{{ asset('css/style.css') }}">
  {% block extra_css %}{% endblock %}
</head>
<body>

  {# ===== NAVBAR ===== #}
  <nav class="navbar">
    <div class="logo"><a href="{{ path('app_home') }}">Covo<span>ISET</span></a></div>
    <div class="nav-links">
      <a href="#features" class="hide-mobile">Fonctionnalités</a>
      <a href="#how" class="hide-mobile">Comment ça marche</a>
      <a href="{{ path('app_login') }}">Connexion</a>
      <a href="{{ path('app_register') }}" class="btn-nav">S'inscrire</a>
    </div>
  </nav>

  {# ===== PAGE CONTENT ===== #}
  {% block body %}{% endblock %}

  {# ===== FOOTER ===== #}
  <footer>
    <p>© {{ "now"|date("Y") }} <span>CovoISET</span> — ISET Kélibia · Projet Universitaire 2025/2026</p>
  </footer>

  {# ===== TOAST ===== #}
  <div class="toast-container"></div>

  <script src="{{ asset('js/app.js') }}"></script>
  {% block extra_js %}{% endblock %}

</body>
</html>
