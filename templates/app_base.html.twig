{% import '_macros.html.twig' as m %}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}{% endblock %} — CovoISET</title>
  <link rel="stylesheet" href="{{ asset('css/style.css') }}">
  {% block extra_css %}{% endblock %}
</head>
<body>
  <div class="app-layout">

    {# ===== SIDEBAR ===== #}
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-logo">Covo<span>ISET</span></div>
      <div class="sidebar-user">
        <div class="user-avatar">
          {{ m.avatar(app.user.initials|default('?'), 'md', 'accent') }}
        </div>
        <div class="user-info">
          <div class="name">{{ app.user.fullName|default('Visiteur') }}</div>
          <div class="role">
            {% if app.user %}
              {% if 'ROLE_ADMIN' in app.user.roles %}
                🛡️ Administrateur
              {% elseif 'ROLE_CONDUCTEUR' in app.user.roles %}
                🚗 Conducteur
              {% else %}
                🧍 Passager
              {% endif %}
            {% else %}
              🌐 Non connecté
            {% endif %}
          </div>
        </div>
      </div>

      <nav class="sidebar-nav">
        {% if is_granted('ROLE_ADMIN') %}
          <div class="nav-section">Administration</div>
          <a href="{{ path('admin_users') }}"
             class="{{ app.request.attributes.get('_route') starts with 'admin_user' ? 'active' : '' }}">
            <span class="icon">👥</span> Utilisateurs
          </a>
          <a href="{{ path('admin_trajet_index') }}"
             class="{{ app.request.attributes.get('_route') starts with 'admin_trajet' ? 'active' : '' }}">
            <span class="icon">🛡️</span> Trajets
          </a>
        {% elseif is_granted('ROLE_CONDUCTEUR') %}
          {% block sidebar_nav_conducteur %}{% endblock %}
        {% else %}
          {% block sidebar_nav_passager %}{% endblock %}
        {% endif %}

        {% block sidebar_nav %}{% endblock %}

        <div class="nav-section">Compte</div>
        {% if app.user %}
          {% if is_granted('ROLE_ADMIN') %}
            <div style="padding: 0.75rem 1rem; font-size: 0.85rem; color: var(--text-muted); font-style: italic;">
              Session modérateur
            </div>
          {% elseif is_granted('ROLE_CONDUCTEUR') %}
            <a href="{{ path('conducteur_profile') }}"
               class="{{ app.request.attributes.get('_route') == 'conducteur_profile' ? 'active' : '' }}">
              <span class="icon">👤</span> Mon profil
            </a>
            <a href="{{ path('conducteur_notation') }}"
               class="{{ app.request.attributes.get('_route') == 'conducteur_notation' ? 'active' : '' }}">
              <span class="icon">⭐</span> Mes évaluations
            </a>
          {% else %}
            <a href="{{ path('passager_profile') }}"
               class="{{ app.request.attributes.get('_route') == 'passager_profile' ? 'active' : '' }}">
              <span class="icon">👤</span> Mon profil
            </a>
            <a href="{{ path('passager_notation') }}"
               class="{{ app.request.attributes.get('_route') == 'passager_notation' ? 'active' : '' }}">
              <span class="icon">⭐</span> Mes évaluations
            </a>
          {% endif %}
        {% else %}
          <a href="{{ path('app_login') }}">
            <span class="icon">🔑</span> Connexion
          </a>
          <a href="{{ path('app_register') }}">
            <span class="icon">📝</span> Inscription
          </a>
        {% endif %}
      </nav>

      <div class="sidebar-footer">
        <a href="{{ path('app_home') }}">🏠 Accueil</a>
        {% if app.user %}
          <a href="{{ path('app_logout') }}">🚪 Déconnexion</a>
        {% endif %}
      </div>
    </aside>

    {# ===== MAIN CONTENT ===== #}
    <main class="main-content">
      <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;">
        <div id="hamburger" class="hamburger">
          <span></span><span></span><span></span>
        </div>
        <div>
          <h1 style="font-size:1.5rem;">{% block page_title %}{% endblock %}</h1>
          <p style="color:var(--text-muted);font-size:0.9rem;">{% block page_subtitle %}{% endblock %}</p>
        </div>
        {% block page_header_actions %}{% endblock %}
      </div>

      {# Flash messages #}
      {{ m.flash_messages() }}

      {% block body %}{% endblock %}
    </main>

  </div>{# end .app-layout #}

  <div class="toast-container"></div>
  <script src="{{ asset('js/app.js') }}"></script>
  {% block extra_js %}{% endblock %}

</body>
</html>
