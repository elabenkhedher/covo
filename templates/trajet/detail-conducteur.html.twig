{% extends 'app_base.html.twig' %}
{% import '_macros.html.twig' as m %}

{% block title %}Détail de mon trajet{% endblock %}
{% block page_title %}Gestion du trajet{% endblock %}
{% block page_subtitle %}Consultez les réservations et gérez votre trajet{% endblock %}

{% block extra_css %}
<style>
  .detail-layout { display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; }
  @media(max-width:900px) { .detail-layout { grid-template-columns: 1fr; } }
  
  .card { background: #fff; border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow); margin-bottom: 1.5rem; }
  .card h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; }
  
  .route-header { font-family: 'Syne', sans-serif; font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem; }
  .route-header .arrow { color: var(--accent); margin: 0 0.5rem; }
  .status-badge { display: inline-block; padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600; margin-bottom: 1rem; }
  
  .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem; }
  .info-box { background: var(--bg); padding: 1rem; border-radius: 8px; }
  .info-box .label { display: block; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.25rem; }
  .info-box .value { font-weight: 600; font-size: 1.1rem; }
  
  .passenger-item { display: flex; align-items: center; justify-content: space-between; padding: 1rem; border: 1px solid var(--border); border-radius: 8px; margin-bottom: 0.75rem; }
  .passenger-info { display: flex; align-items: center; gap: 1rem; }
  .passenger-name { font-weight: 600; }
  .passenger-meta { font-size: 0.85rem; color: var(--text-muted); }
  
  .action-buttons { display: flex; flex-direction: column; gap: 0.75rem; }
</style>
{% endblock %}

{% block sidebar_nav %}
  <div class="nav-section">Navigation</div>
  <a href="{{ path('conducteur_dashboard') }}"><span class="icon">🏠</span> Tableau de bord</a>
  <a href="{{ path('trajet_publier') }}"><span class="icon">➕</span> Publier un trajet</a>
  <a href="{{ path('trajet_mes_trajets') }}" class="active"><span class="icon">🚗</span> Mes trajets</a>
  <a href="{{ path('conducteur_tracking') }}"><span class="icon">📍</span> GPS en direct</a>
{% endblock %}

{% block body %}
  <div class="detail-layout">
    
    {# ===== GAUCHE : INFOS TRAJET & PASSAGERS ===== #}
    <div>
      <div class="card">
        {{ m.badge_statut_trajet(trajet.statut) }}
        <div class="route-header">
          {{ trajet.villeDepart }} <span class="arrow">→</span> {{ trajet.villeArrivee }}
        </div>
        
        <div class="info-grid">
          <div class="info-box">
            <span class="label">Date & Heure</span>
            <span class="value">{{ trajet.dateDepart|date('D. d M') }} à {{ trajet.heureDepart }}</span>
          </div>
          <div class="info-box">
            <span class="label">Places réservées</span>
            <span class="value" style="color:var(--primary);">{{ trajet.placesReservees }} / {{ trajet.placesTotales }}</span>
          </div>
          <div class="info-box">
            <span class="label">Prix par place</span>
            <span class="value">{{ trajet.prix }} DT</span>
          </div>
          <div class="info-box">
            <span class="label">Point de RDV</span>
            <span class="value">{{ trajet.pointRendezVous|default('Non spécifié') }}</span>
          </div>
        </div>
      </div>

      <div class="card">
        <h3>👥 Passagers ayant réservé ({{ passagers|length }})</h3>
        
        {% for item in passagers %}
          <div class="passenger-item">
            <div class="passenger-info">
              {{ m.avatar(item.user.initials, 'md', 'primary') }}
              <div>
                <div class="passenger-name">{{ item.user.prenom }} {{ item.user.nom }}</div>
                <div class="passenger-meta">
                  Réservation: {{ item.reservation.places }} place(s) · Statut: {{ m.badge(item.reservation.statut, 'info') }}
                </div>
              </div>
            </div>
          </div>
        {% else %}
          <div style="text-align: center; padding: 2rem; color: var(--text-muted);">
            <div style="font-size: 2rem; margin-bottom: 0.5rem;">💺</div>
            Aucune réservation pour le moment.
          </div>
        {% endfor %}
      </div>
    </div>

    {# ===== DROITE : ACTIONS ===== #}
    <div>
      <div class="card">
        <h3>⚡ Actions</h3>
        <div class="action-buttons">
          {% if trajet.statut == 'actif' %}
            <a href="{{ path('trajet_modifier', {id: trajet.id}) }}" class="btn btn-outline" style="justify-content: center;">
              ✏️ Modifier le trajet
            </a>
            
            <a href="{{ path('conducteur_tracking', {trajetId: trajet.id}) }}" class="btn btn-accent" style="justify-content: center;">
              📍 Démarrer le trajet (GPS)
            </a>
            
            <hr style="border:0; border-top:1px solid var(--border); margin: 0.5rem 0;">
            
            <form action="{{ path('conducteur_annuler_trajet', {id: trajet.id}) }}" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler ce trajet ? Les passagers seront remboursés.');">
               <input type="hidden" name="_token" value="{{ csrf_token('annuler_' ~ trajet.id) }}">
               <button type="submit" class="btn btn-danger" style="width: 100%; justify-content: center;">🚫 Annuler le trajet</button>
            </form>
          {% elseif trajet.statut == 'en_cours' %}
             <a href="{{ path('conducteur_tracking', {trajetId: trajet.id}) }}" class="btn btn-accent" style="justify-content: center;">
              📍 Reprendre le suivi GPS
            </a>
          {% else %}
            <div style="text-align:center; color:var(--text-muted); font-size:0.9rem;">
              Ce trajet est {{ trajet.statut }}.<br>Aucune action disponible.
            </div>
          {% endif %}
        </div>
      </div>
    </div>
    
  </div>
{% endblock %}
