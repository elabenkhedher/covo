{% extends 'auth_base.html.twig' %}

{% block title %}Réinitialisation du mot de passe{% endblock %}

{% block extra_auth_style %}
  .signup-link { text-align: center; margin-top: 1.25rem; font-size: 0.9rem; color: var(--text-muted); }
  .signup-link a { color: var(--primary); font-weight: 600; }
  .strength-bar { height: 4px; border-radius: 4px; background: var(--border); margin-top: 0.35rem; overflow: hidden; }
  .strength-fill { height: 100%; border-radius: 4px; transition: width 0.3s, background 0.3s; }
{% endblock %}

{% block auth_illustration %}🔑{% endblock %}
{% block auth_left_title %}Nouveau mot de passe{% endblock %}
{% block auth_left_text %}Choisissez un mot de passe fort pour sécuriser votre compte CovoISET.{% endblock %}

{% block auth_form %}
  <h2>Réinitialisation</h2>
  <p class="subtitle">Entrez votre nouveau mot de passe</p>

  <div class="form-card">
    <form action="{{ path('app_reset_password') }}" method="POST">
      <input type="hidden" name="token" value="{{ token }}">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset-password') }}">

      <div class="form-group">
        <label for="password">Nouveau mot de passe</label>
        <input type="password" class="form-control" id="password" name="password"
               placeholder="Minimum 8 caractères" required
               oninput="checkStrength(this.value)">
        <div class="strength-bar">
          <div class="strength-fill" id="strengthFill" style="width:0%;background:var(--danger);"></div>
        </div>
        <div id="strengthLabel" style="font-size:0.78rem;margin-top:0.25rem;color:var(--text-muted);"></div>
      </div>

      <div class="form-group">
        <label for="password_confirm">Confirmer le mot de passe</label>
        <input type="password" class="form-control" id="password_confirm" name="password_confirm"
               placeholder="Répétez votre mot de passe" required>
        <div class="form-error" id="matchError"></div>
      </div>

      <button type="submit" class="btn btn-primary btn-full" onclick="return validatePasswords()">
        Réinitialiser →
      </button>

      <div class="signup-link">
        <a href="{{ path('app_login') }}">Retour à la connexion</a>
      </div>
    </form>
  </div>
{% endblock %}

{% block extra_js %}
<script>
  function checkStrength(val) {
    let score = 0;
    if (val.length >= 8)  score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;
    const levels = [
      { w: '0%',   color: 'var(--danger)',  label: '' },
      { w: '25%',  color: 'var(--danger)',  label: 'Très faible' },
      { w: '50%',  color: 'var(--warning)', label: 'Moyen' },
      { w: '75%',  color: '#3b82f6',        label: 'Fort' },
      { w: '100%', color: 'var(--success)', label: 'Très fort' }
    ];
    const l = levels[score];
    document.getElementById('strengthFill').style.cssText = `width:${l.w};background:${l.color};`;
    document.getElementById('strengthLabel').textContent = l.label;
    document.getElementById('strengthLabel').style.color = l.color;
  }
  function validatePasswords() {
    const p1 = document.getElementById('password').value;
    const p2 = document.getElementById('password_confirm').value;
    if (p1 !== p2) {
      document.getElementById('matchError').textContent = 'Les mots de passe ne correspondent pas.';
      return false;
    }
    document.getElementById('matchError').textContent = '';
    return true;
  }
</script>
{% endblock %}
