{% extends 'base.html.twig' %}

{% block title %}CovoISET — Plateforme de Covoiturage{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="{{ asset('assets/style.css') }}">
  <style>
    .hero {
      background: linear-gradient(135deg, var(--primary) 0%, #0f2147 60%, #1a1a2e 100%);
      min-height: 90vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 4rem 2rem;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(249,115,22,0.15) 0%, transparent 70%);
      top: -100px; right: -100px;
      border-radius: 50%;
    }
    .hero::after {
      content: '';
      position: absolute;
      width: 400px; height: 400px;
      background: radial-gradient(circle, rgba(42,82,152,0.3) 0%, transparent 70%);
      bottom: -50px; left: -50px;
      border-radius: 50%;
    }
    .hero-content { position: relative; z-index: 1; max-width: 780px; }
    .hero-badge {
      display: inline-block;
      background: rgba(249,115,22,0.2);
      border: 1px solid rgba(249,115,22,0.4);
      color: var(--accent-light);
      padding: 0.4rem 1.2rem;
      border-radius: 50px;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.5px;
      margin-bottom: 1.5rem;
    }
    .hero h1 {
      font-size: clamp(2.2rem, 6vw, 4rem);
      color: #fff;
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 1.25rem;
    }
    .hero h1 span { color: var(--accent); }
    .hero p {
      color: rgba(255,255,255,0.7);
      font-size: 1.15rem;
      line-height: 1.7;
      margin-bottom: 2.5rem;
      max-width: 560px;
      margin-left: auto; margin-right: auto;
    }
    .hero-cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

    /* SEARCH BAR */
    .search-section {
      background: #fff;
      border-radius: 20px;
      padding: 2rem;
      box-shadow: var(--shadow-lg);
      max-width: 860px;
      margin: -3rem auto 4rem;
      position: relative;
      z-index: 10;
    }
    .search-section h3 {
      font-size: 1.1rem;
      margin-bottom: 1.25rem;
      color: var(--text-muted);
      font-weight: 500;
    }
    .search-row {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr auto;
      gap: 1rem;
      align-items: end;
    }
    @media(max-width:700px) { .search-row { grid-template-columns: 1fr; } }

    /* FEATURES */
    .features { padding: 5rem 2rem; max-width: 1100px; margin: 0 auto; }
    .features-header { text-align: center; margin-bottom: 3rem; }
    .features-header h2 { font-size: 2.2rem; font-weight: 800; margin-bottom: 0.75rem; }
    .features-header p { color: var(--text-muted); font-size: 1rem; max-width: 500px; margin: 0 auto; }
    .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; }
    .feature-card {
      background: #fff;
      border-radius: var(--radius);
      padding: 2rem;
      box-shadow: var(--shadow);
      text-align: center;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .feature-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); }
    .feature-icon {
      width: 64px; height: 64px;
      background: linear-gradient(135deg, var(--primary), var(--primary-light));
      border-radius: 16px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.8rem;
      margin: 0 auto 1.25rem;
    }
    .feature-card h4 { font-size: 1.05rem; margin-bottom: 0.5rem; }
    .feature-card p { color: var(--text-muted); font-size: 0.88rem; line-height: 1.6; }

    /* HOW IT WORKS */
    .how { background: var(--primary); padding: 5rem 2rem; }
    .how-inner { max-width: 1000px; margin: 0 auto; text-align: center; }
    .how h2 { color: #fff; font-size: 2rem; font-weight: 800; margin-bottom: 0.75rem; }
    .how > .how-inner > p { color: rgba(255,255,255,0.6); margin-bottom: 3rem; }
    .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; }
    .step { text-align: center; }
    .step-num {
      width: 56px; height: 56px;
      background: var(--accent);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Syne', sans-serif;
      font-size: 1.3rem;
      font-weight: 800;
      color: #fff;
      margin: 0 auto 1rem;
    }
    .step h4 { color: #fff; margin-bottom: 0.5rem; }
    .step p { color: rgba(255,255,255,0.55); font-size: 0.88rem; line-height: 1.6; }

    /* CTA BOTTOM */
    .cta-bottom { text-align: center; padding: 5rem 2rem; }
    .cta-bottom h2 { font-size: 2rem; font-weight: 800; margin-bottom: 1rem; }
    .cta-bottom p { color: var(--text-muted); margin-bottom: 2rem; }

    /* FOOTER */
    footer {
      background: var(--text);
      color: rgba(255,255,255,0.6);
      text-align: center;
      padding: 1.5rem;
      font-size: 0.88rem;
    }
    footer span { color: var(--accent); }
  </style>
{% endblock %}

{% block body %}
  <!-- NAVBAR -->
  <nav class="navbar">
    <div class="logo">Covo<span>ISET</span></div>
    <div class="nav-links">
      <a href="#features" class="hide-mobile">Fonctionnalités</a>
      <a href="#how" class="hide-mobile">Comment ça marche</a>
      <a href="{{ path('app_login') }}">Connexion</a>
      <a href="{{ path('app_register') }}" class="btn-nav">S'inscrire</a>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-badge">🎓 ISET Kélibia — Année 2025/2026</div>
      <h1>Le covoiturage<br><span>intelligent</span> pour l'ISET</h1>
      <p>Connectez conducteurs et passagers en toute sécurité. Réservez, payez et suivez vos trajets en temps réel.</p>
      <div class="hero-cta">
        <a href="{{ path('app_register') }}" class="btn btn-accent btn-lg">Commencer gratuitement →</a>
        <a href="search.html" class="btn btn-lg" style="background:rgba(255,255,255,0.12);color:#fff;border:1px solid rgba(255,255,255,0.25);">Rechercher un trajet</a>
      </div>
    </div>
  </section>

  <!-- SEARCH BAR -->
  <div style="padding: 0 2rem; background: var(--bg);">
    <div class="search-section">
      <h3>🔍 Trouvez votre trajet rapidement</h3>
      <div class="search-row">
        <div class="form-group" style="margin:0">
          <label>Ville de départ</label>
          <input type="text" class="form-control" placeholder="Ex: Tunis">
        </div>
        <div class="form-group" style="margin:0">
          <label>Ville d'arrivée</label>
          <input type="text" class="form-control" placeholder="Ex: Kélibia">
        </div>
        <div class="form-group" style="margin:0">
          <label>Date</label>
          <input type="date" class="form-control">
        </div>
        <a href="search.html" class="btn btn-accent" style="white-space:nowrap">Rechercher</a>
      </div>
    </div>
  </div>

  <!-- FEATURES -->
  <section class="features" id="features">
    <div class="features-header">
      <h2>Tout ce dont vous avez besoin</h2>
      <p>Une plateforme complète pour organiser vos déplacements universitaires</p>
    </div>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">🔐</div>
        <h4>Authentification Sécurisée</h4>
        <p>Inscription vérifiée par email, tokens JWT et hachage Bcrypt pour protéger votre compte.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🚗</div>
        <h4>Publication de Trajets</h4>
        <p>Conducteurs : publiez vos trajets en quelques clics avec date, heure, places et prix.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">📍</div>
        <h4>Suivi GPS Temps Réel</h4>
        <p>Suivez la position du conducteur en direct via WebSockets. ETA précis, latence &lt; 1 seconde.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">💳</div>
        <h4>Paiement Sécurisé</h4>
        <p>Réglez votre réservation en ligne. Remboursement automatique en cas d'annulation.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⭐</div>
        <h4>Système de Notation</h4>
        <p>Évaluez conducteurs et passagers après chaque trajet pour une communauté de confiance.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">📊</div>
        <h4>Tableau de Bord Admin</h4>
        <p>Statistiques complètes, modération des comptes et export des rapports pour les admins.</p>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="how" id="how">
    <div class="how-inner">
      <h2>Comment ça marche ?</h2>
      <p>En 4 étapes simples, organisez ou rejoignez un covoiturage</p>
      <div class="steps">
        <div class="step">
          <div class="step-num">1</div>
          <h4>Créez votre compte</h4>
          <p>Inscrivez-vous en choisissant votre rôle : Passager ou Conducteur</p>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <h4>Publiez ou cherchez</h4>
          <p>Conducteur : publiez votre trajet. Passager : filtrez et trouvez votre covoiturage</p>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <h4>Réservez et payez</h4>
          <p>Confirmez votre place avec un paiement sécurisé en ligne</p>
        </div>
        <div class="step">
          <div class="step-num">4</div>
          <h4>Voyagez et notez</h4>
          <p>Suivez le trajet en temps réel et laissez un avis après l'arrivée</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BOTTOM -->
  <section class="cta-bottom">
    <h2>Prêt à covoiturer ?</h2>
    <p>Rejoignez la communauté CovoISET dès aujourd'hui</p>
    <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg" style="margin-right:1rem">Créer un compte</a>
    <a href="{{ path('app_login') }}" class="btn btn-outline btn-lg">Se connecter</a>
  </section>

  <footer>
    <p>© 2025 <span>CovoISET</span> — ISET Kélibia · Projet Universitaire 2025/2026</p>
  </footer>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('assets/app.js') }}"></script>
{% endblock %}
