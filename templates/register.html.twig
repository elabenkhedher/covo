{% extends 'auth_base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block auth_left_gradient %}linear-gradient(160deg, #0f2147 0%, var(--primary) 100%){% endblock %}
{% block auth_right_width %}520px{% endblock %}
{% block auth_right_extra_style %}overflow-y: auto;{% endblock %}
{% block auth_form_max_width %}440px{% endblock %}

{% block extra_auth_style %}
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .role-choice { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem; }
  .role-option {
    border: 2px solid var(--border); border-radius: 12px;
    padding: 1.25rem 1rem; text-align: center;
    cursor: pointer; transition: all 0.2s;
  }
  .role-option:hover { border-color: var(--primary-light); }
  .role-option.selected { border-color: var(--primary); background: #eff6ff; }
  .role-option .role-icon { font-size: 2rem; margin-bottom: 0.5rem; }
  .role-option h4 { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.2rem; }
  .role-option p { font-size: 0.78rem; color: var(--text-muted); }
  .login-link { text-align: center; margin-top: 1.25rem; font-size: 0.9rem; color: var(--text-muted); }
  .login-link a { color: var(--primary); font-weight: 600; }
  .step-indicator { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }
  .step-dot { flex: 1; height: 4px; border-radius: 4px; background: var(--border); transition: background 0.3s; }
  .step-dot.active { background: var(--primary); }
  .step-dot.done { background: var(--success); }
  .section-label {
    font-size: 0.78rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.8px; color: var(--text-muted);
    margin-bottom: 0.75rem; margin-top: 0.5rem;
  }
  @media(max-width:768px) { .form-row { grid-template-columns: 1fr; } }
{% endblock %}

{% block auth_illustration %}🎓{% endblock %}
{% block auth_left_title %}Rejoignez la communauté !{% endblock %}
{% block auth_left_text %}Créez votre compte et commencez à covoiturer avec vos camarades de l'ISET Kélibia.{% endblock %}

{% block auth_form %}
  <h2>Créer un compte</h2>
  <p class="subtitle">Remplissez le formulaire pour commencer</p>

  <div class="form-card">
    <form action="{{ path('app_register') }}" method="POST" id="regForm">
      <div class="step-indicator">
        <div class="step-dot active" id="s1"></div>
        <div class="step-dot" id="s2"></div>
        <div class="step-dot" id="s3"></div>
      </div>

      {# Hidden role field #}
      <input type="hidden" name="registration_form[roleChoice]" id="roleChoiceInput" value="ROLE_PASSAGER">
      <input type="hidden" name="registration_form[_token]" value="{{ csrf_token('registration_form') }}">

      {# STEP 1 — Choix du rôle #}
      <div id="step1">
        <div class="section-label">Choisissez votre rôle</div>
        <div class="role-choice">
          <div class="role-option selected" id="role-passager" onclick="selectRole('ROLE_PASSAGER')">
            <div class="role-icon">🧍</div>
            <h4>Passager</h4>
            <p>Je cherche des trajets et réserve des places</p>
          </div>
          <div class="role-option" id="role-conducteur" onclick="selectRole('ROLE_CONDUCTEUR')">
            <div class="role-icon">🚗</div>
            <h4>Conducteur</h4>
            <p>Je propose mes trajets et transporte des passagers</p>
          </div>
        </div>
        <button type="button" class="btn btn-primary btn-full" onclick="goStep(2)">Continuer →</button>
      </div>

      {# STEP 2 — Informations personnelles #}
      <div id="step2" style="display:none">
        <div class="section-label">Informations personnelles</div>
        <div class="form-row">
          <div class="form-group">
            <label>Prénom</label>
            <input type="text" name="registration_form[prenom]" class="form-control" id="prenom" placeholder="Ahmed" required>
            <div class="form-error"></div>
          </div>
          <div class="form-group">
            <label>Nom</label>
            <input type="text" name="registration_form[nom]" class="form-control" id="nom" placeholder="Ben Ali" required>
            <div class="form-error"></div>
          </div>
        </div>
        <div class="form-group">
          <label>Adresse email</label>
          <input type="email" name="registration_form[email]" class="form-control" id="email" placeholder="ahmed@iset.tn" required>
          <div class="form-error"></div>
        </div>
        <div class="form-group">
          <label>Téléphone</label>
          <input type="tel" name="registration_form[telephone]" class="form-control" id="tel" placeholder="+216 XX XXX XXX">
          <div class="form-error"></div>
        </div>

        {# Vehicle section (conducteur only) #}
        <div id="car-info-section" style="display:none; margin-top:1rem;">
          <div class="section-label">Informations sur le véhicule</div>
          <div class="form-row">
            <div class="form-group">
              <label>Marque & Modèle</label>
              <input type="text" name="registration_form[marqueVehicule]" class="form-control" id="car-model" placeholder="Ex: Peugeot 208">
            </div>
            <div class="form-group">
              <label>Immatriculation</label>
              <input type="text" name="registration_form[immatriculation]" class="form-control" id="car-plate" placeholder="123 TN 4567">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Couleur</label>
              <input type="text" name="registration_form[couleur]" class="form-control" id="car-color" placeholder="Ex: Blanc">
            </div>
            <div class="form-group">
              <label>Places disponibles</label>
              <input type="number" name="registration_form[nbPlacesVehicule]" class="form-control" id="car-seats" placeholder="4" min="1" max="8">
            </div>
          </div>
        </div>

        <div style="display:flex;gap:0.75rem;margin-top:1.5rem;">
          <button type="button" class="btn btn-outline" onclick="goStep(1)">← Retour</button>
          <button type="button" class="btn btn-primary" style="flex:1" onclick="goStep(3)">Continuer →</button>
        </div>
      </div>

      {# STEP 3 — Sécurité #}
      <div id="step3" style="display:none">
        <div class="section-label">Sécurité du compte</div>
        <div class="form-group">
          <label>Mot de passe</label>
          <input type="password" name="registration_form[plainPassword]" class="form-control" id="password" placeholder="Minimum 8 caractères" required>
          <div class="form-error"></div>
        </div>
        <div class="form-group">
          <label>Confirmer le mot de passe</label>
          <input type="password" class="form-control" id="password2" placeholder="Répétez le mot de passe" required>
          <div class="form-error"></div>
        </div>
        <div class="form-group" style="display:flex;align-items:flex-start;gap:0.6rem;">
          <input type="checkbox" name="registration_form[agreeTerms]" id="terms" style="margin-top:4px;">
          <label for="terms" style="font-size:0.85rem;color:var(--text-muted);">
            J'accepte les <a href="#" style="color:var(--primary)">conditions d'utilisation</a> et la politique de confidentialité
          </label>
        </div>
        <div style="display:flex;gap:0.75rem;">
          <button type="button" class="btn btn-outline" onclick="goStep(2)">← Retour</button>
          <button type="button" class="btn btn-accent" style="flex:1" onclick="handleRegister()">Créer mon compte ✓</button>
        </div>
      </div>
    </form>

    <div class="login-link" style="margin-top:1.25rem;">
      Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a>
    </div>
  </div>

  <div style="text-align:center;margin-top:1.5rem;">
    <a href="{{ path('app_home') }}" style="color:var(--text-muted);font-size:0.88rem;">← Retour à l'accueil</a>
  </div>
{% endblock %}

{% block extra_js %}
<script>
  let selectedRole = 'ROLE_PASSAGER';
  function selectRole(r) {
    selectedRole = r;
    document.getElementById('roleChoiceInput').value = r;
    document.getElementById('role-passager').classList.toggle('selected', r === 'ROLE_PASSAGER');
    document.getElementById('role-conducteur').classList.toggle('selected', r === 'ROLE_CONDUCTEUR');
  }
  function goStep(n) {
    if (n === 2) {
      document.getElementById('car-info-section').style.display = selectedRole === 'ROLE_CONDUCTEUR' ? 'block' : 'none';
    }
    [1,2,3].forEach(i => {
      const step = document.getElementById('step'+i);
      if (step) step.style.display = i === n ? 'block' : 'none';
      const dot = document.getElementById('s'+i);
      if (dot) {
        dot.classList.toggle('active', i === n);
        dot.classList.toggle('done', i < n);
      }
    });
  }
  function handleRegister() {
    const p1 = document.getElementById('password').value;
    const p2 = document.getElementById('password2').value;
    if (p1 !== p2) { showToast('Les mots de passe ne correspondent pas.', 'error'); return; }
    if (!document.getElementById('terms').checked) { showToast('Veuillez accepter les conditions.', 'warning'); return; }
    
    // Submit the real form
    document.getElementById('regForm').submit();
  }
</script>
{% endblock %}
